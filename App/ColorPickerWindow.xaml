<Window x:Class="MilookDeck.App.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色の設定" Icon="MilookDeck.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="14">
    <Window.Resources>
        <!-- 透け具合を見せるためのチェック柄 -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Viewbox="0,0,12,12" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,12,12"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,6,6"/>
                                <RectangleGeometry Rect="6,6,6,6"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 入力欄の右クリックメニュー: 切り取り・コピー・貼り付けだけ(標準のメニューに出る文字変換の候補などは出さない) -->
        <ContextMenu x:Key="EditMenu">
            <MenuItem Command="ApplicationCommands.Cut" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Command="ApplicationCommands.Paste" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <!-- 見本の上の文字: 白文字に、黒のぼかしの縁取り(どんな色の上でも読めるように)。濃さは、重ねる枚数(下の見本の欄)とぼかしの半径(BlurRadius)で調整する -->
        <Style x:Key="Halo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Opacity="1" RenderingBias="Quality"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <!-- BasedOn で、テーマ(ライト/ダーク)の標準の入力欄の見た目を引き継ぐ -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ContextMenu" Value="{StaticResource EditMenu}"/>
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="6,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <!-- 大きさ・配置は試作画像(幅560×高さ358)に合わせる -->
    <Grid Width="560" Height="358">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="19,10,19,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 色の四角形・色相・透明度・基本色 -->
            <StackPanel Grid.Column="0">
                <Grid x:Name="SvBox" Width="214" Height="137" Cursor="Cross"
                      MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Drag_Up">
                    <Grid.Clip><RectangleGeometry Rect="0,0,214,137" RadiusX="6" RadiusY="6"/></Grid.Clip>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop x:Name="SvHueStop" Color="Red" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Grid x:Name="SvThumb" Width="16" Height="16">
                            <Ellipse Stroke="Black" StrokeThickness="1"/>
                            <Ellipse Margin="1" Stroke="White" StrokeThickness="2"/>
                        </Grid>
                    </Canvas>
                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="#40808080" IsHitTestVisible="False"/>
                </Grid>

                <Grid x:Name="HueBar" Width="214" Height="15" Margin="0,13,0,0" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Drag_Up">
                    <Border CornerRadius="7.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Grid x:Name="HueThumb" Width="21" Height="21" Canvas.Top="-3">
                            <Ellipse Fill="#FF3B9AE8" Stroke="White" StrokeThickness="3"/>
                            <Ellipse Stroke="#80000000" StrokeThickness="1"/>
                        </Grid>
                    </Canvas>
                </Grid>

                <Grid x:Name="AlphaBar" Width="214" Height="15" Margin="0,12,0,0" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Alpha_Down" MouseMove="Alpha_Move" MouseLeftButtonUp="Drag_Up">
                    <Border CornerRadius="7.5" Background="{StaticResource Checker}"/>
                    <Border CornerRadius="7.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="AlphaStop0" Color="#0000AAAA" Offset="0"/>
                                <GradientStop x:Name="AlphaStop1" Color="#FF00AAAA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Grid x:Name="AlphaThumb" Width="21" Height="21" Canvas.Top="-3">
                            <Ellipse Fill="#FF3B9AE8" Stroke="White" StrokeThickness="3"/>
                            <Ellipse Stroke="#80000000" StrokeThickness="1"/>
                        </Grid>
                    </Canvas>
                </Grid>

                <TextBlock Text="基本色" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                <WrapPanel x:Name="Swatches" Width="220" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- 右: 新しい色/現在の色・コード・A R G B・表示例 -->
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <Grid Height="62">
                    <Grid.Clip><RectangleGeometry Rect="0,0,290,62" RadiusX="6" RadiusY="6"/></Grid.Clip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="{StaticResource Checker}"/>
                    <Border x:Name="NewSwatch" Grid.Column="0">
                        <!-- 縁取りが濃くなるよう、同じ文字を8枚重ねる -->
                        <Grid VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="新しい色" Style="{StaticResource Halo}"/>
                        </Grid>
                    </Border>
                    <Border x:Name="OldSwatch" Grid.Column="1">
                        <!-- 縁取りが濃くなるよう、同じ文字を8枚重ねる -->
                        <Grid VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                            <TextBlock Text="現在の色" Style="{StaticResource Halo}"/>
                        </Grid>
                    </Border>
                    <Border Grid.ColumnSpan="2" CornerRadius="6" BorderThickness="1" BorderBrush="#40808080" IsHitTestVisible="False"/>
                </Grid>

                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="コード" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                    <TextBox x:Name="HexBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Field}" HorizontalContentAlignment="Left"
                             GotKeyboardFocus="Box_GotFocus" LostFocus="Hex_Commit" PreviewKeyDown="Hex_KeyDown"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="A" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                    <TextBox x:Name="ABox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Tag="A"
                             GotKeyboardFocus="Box_GotFocus" LostFocus="Num_Commit" PreviewKeyDown="Num_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="R" Style="{StaticResource Label}" Margin="12,0,0,10"/>
                    <TextBox x:Name="RBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource Field}" Tag="R"
                             GotKeyboardFocus="Box_GotFocus" LostFocus="Num_Commit" PreviewKeyDown="Num_KeyDown"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="G" Style="{StaticResource Label}" Margin="12,0,0,10"/>
                    <TextBox x:Name="GBox" Grid.Row="2" Grid.Column="3" Style="{StaticResource Field}" Tag="G"
                             GotKeyboardFocus="Box_GotFocus" LostFocus="Num_Commit" PreviewKeyDown="Num_KeyDown"/>

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="B" Style="{StaticResource Label}" Margin="12,0,0,10"/>
                    <TextBox x:Name="BBox" Grid.Row="3" Grid.Column="3" Style="{StaticResource Field}" Tag="B"
                             GotKeyboardFocus="Box_GotFocus" LostFocus="Num_Commit" PreviewKeyDown="Num_KeyDown"/>
                </Grid>

                <!-- 表示例(黒い背景の上に、選んだ色で) -->
                <Border Height="40" CornerRadius="6" Background="Black" Margin="0,3,0,0">
                    <TextBlock x:Name="SampleText" Text="19:00-20:54  〇△□テレビ  番組名" FontSize="15"
                               VerticalAlignment="Center" Margin="12,0"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="53" BorderThickness="0,1,0,0" BorderBrush="#30808080" Background="#10808080">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,19,0">
                <Button Content="OK" Width="95" Height="32" IsDefault="True" Click="Ok_Click"/>
                <Button Content="キャンセル" Width="97" Height="32" Margin="12,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
