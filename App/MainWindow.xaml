<Window x:Class="MilookDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="MilookDeck" Icon="MilookDeck.ico" Width="960" Height="440" MinWidth="640" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontWeight="Bold">
    <!-- 枠なしウィンドウの周囲に、ライトテーマで白く出る太い縁(サイズ変更用の非クライアント領域)を出さない。
         サイズ変更は、ウィンドウの端(黒い縁取りと同じ幅5の範囲。見えない当たり判定)をつかんで行う -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" NonClientFrameEdges="None"
                      ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 実行時に設定画面の値で差し替える -->
        <SolidColorBrush x:Key="WindowBrush" Color="#3B3B3B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#00AAAA"/>
        <SolidColorBrush x:Key="ListBackBrush" Color="Black"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#3BAAAAAA"/>
        <SolidColorBrush x:Key="SelectBrush" Color="#80004080"/>

        <!-- 番組内容を表示するまでの時間(ミリ秒)と、表示する/しない。実行時に設定画面の値で差し替える -->
        <sys:Int32 x:Key="DetailDelayMs">1000</sys:Int32>
        <sys:Boolean x:Key="DetailEnabled">True</sys:Boolean>
        <!-- チューナー欄の文字の位置(左/中央/右)。実行時に設定画面の値で差し替える -->
        <TextAlignment x:Key="TunerAlign">Left</TextAlignment>

        <!-- 番組内容の表示(左の一覧の行にしばらくマウスを乗せると、マウスの近くに表示)。中身・色・フォントはコードで設定 -->
        <ToolTip x:Key="StationTip" x:Shared="False" Placement="Mouse" HorizontalOffset="14" VerticalOffset="14"
                 BorderBrush="#66808080" BorderThickness="1" Padding="6" IsHitTestVisible="False"/>
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 枠なし。マウスを乗せた時だけ薄く明るくする -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 起動ボタン(ボタン1・2): 枠の画像(BtnFrame.png)を表示。マウスを乗せる/押すと中が少し変わる -->
        <Style x:Key="FrameBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Face" Background="Transparent"/>
                            <Image Source="BtnFrame.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#44000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlackList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ListBackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style x:Key="Item" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ウィンドウの外周を黒(幅5)で縁取る -->
    <Border BorderBrush="Black" BorderThickness="5">
    <Grid x:Name="RootGrid" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightCol" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ドラッグで移動 / 右クリックで「設定」(上部と、縦ボタンスタイルの左側のタイトル帯) -->
        <Border x:Name="DragTop" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent"
                MouseLeftButtonDown="TitleBar_Drag">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="設定" Click="OpenSettings_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
        <Border x:Name="DragLeft" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="Transparent"
                Visibility="Collapsed" MouseLeftButtonDown="TitleBar_Drag">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="設定" Click="OpenSettings_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- ソフト名(画像)。縦ボタンスタイルでは縦書きの画像、横ボタンスタイルでは横書きの画像。配置は ApplyLayout で切り替え -->
        <Image x:Name="TitleImage" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Source="TitleHorizontal.png"
               Width="190" Height="27" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,9,0,0" IsHitTestVisible="False"/>

        <!-- 起動ボタン(ボタン1〜5)。横ボタンスタイル=上部に右からボタン1,2…と横並び / 縦ボタンスタイル=右側に上からボタン1,2…と縦並び -->
        <StackPanel x:Name="AppBtns" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,72,0">
            <Button x:Name="AppBtn1" Style="{StaticResource FrameBtn}" Width="44" Height="38" Margin="0,0,6,0" Tag="0" Click="AppBtn_Click"/>
            <Button x:Name="AppBtn2" Style="{StaticResource FrameBtn}" Width="44" Height="38" Margin="0,0,6,0" Tag="1" Click="AppBtn_Click"/>
            <Button x:Name="AppBtn3" Style="{StaticResource FrameBtn}" Width="44" Height="38" Margin="0,0,6,0" Tag="2" Click="AppBtn_Click"/>
            <Button x:Name="AppBtn4" Style="{StaticResource FrameBtn}" Width="44" Height="38" Margin="0,0,6,0" Tag="3" Click="AppBtn_Click"/>
            <Button x:Name="AppBtn5" Style="{StaticResource FrameBtn}" Width="44" Height="38" Margin="0,0,6,0" Tag="4" Click="AppBtn_Click"/>
        </StackPanel>

        <StackPanel x:Name="WinBtns" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="–" Style="{StaticResource TitleBtn}" Click="Minimize_Click"/>
            <Button Content="X" Style="{StaticResource TitleBtn}" Click="Close_Click"/>
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="TunerCol" Width="150" MinWidth="60"/>
            </Grid.ColumnDefinitions>

            <!-- 境界線をドラッグしてチューナー欄の幅を変更 -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                          DragCompleted="Splitter_DragCompleted"/>

            <!-- 左: 番組一覧(時間・局名・番組名を縦に揃える。ダブルクリックで局切替) -->
            <ListBox x:Name="StationList" Grid.Column="0" Style="{StaticResource BlackList}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColTime"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColStation"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Station}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Item}">
                        <EventSetter Event="MouseDoubleClick" Handler="Station_DoubleClick"/>
                        <EventSetter Event="MouseRightButtonUp" Handler="Station_RightClick"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="Station_LeftClick"/>
                        <Setter Property="ToolTip" Value="{StaticResource StationTip}"/>
                        <Setter Property="ToolTipService.InitialShowDelay" Value="{DynamicResource DetailDelayMs}"/>
                        <Setter Property="ToolTipService.IsEnabled" Value="{DynamicResource DetailEnabled}"/>
                        <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                        <Setter Property="ToolTipService.ShowDuration" Value="600000"/>
                        <EventSetter Event="ToolTipOpening" Handler="Station_ToolTipOpening"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 右: チューナー選択(ダブルクリックで TVTest 起動 / もう一度で終了) -->
            <ListBox x:Name="TunerList" Grid.Column="2" Style="{StaticResource BlackList}"
                     PreviewMouseRightButtonDown="List_RightDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 左側は先頭の印(●/全角空白)の分だけ空くので、右側にも同じ幅(全角空白1つ分)の空きを設けて左右対称にする -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Display}" TextAlignment="{DynamicResource TunerAlign}"/>
                            <TextBlock Grid.Column="1" Text="　"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CloseTunerMenu" Header="終了" Click="CloseTuner_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Item}">
                        <EventSetter Event="MouseDoubleClick" Handler="Tuner_DoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
        <!-- ステータス表示枠: メッセージは5秒表示。消えた後は、本ソフトで切り替えた局の番組情報を常時表示。高さはフォントサイズに連動 -->
        <Border x:Name="StatusBorder" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="12,10,12,0" Padding="8,2"
                Background="{DynamicResource ListBackBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColTime"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColStation"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusTime" Grid.Column="0" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusStation" Grid.Column="1" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusTitle" Grid.Column="2" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
